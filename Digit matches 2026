        <Rule id="R003" type="boolean" expression="input in prime_pattern" resultTag="IsPrime"/>
        <Rule id="R004" type="boolean" expression="input in square_pattern" resultTag="IsPerfectSquare"/>
        <Rule id="R005" type="boolean" expression="input in fib_pattern" resultTag="IsFibonacci"/>
        <Rule id="R006" type="boolean" expression="len(str(input)) == 1" resultTag="IsSingleDigit"/>
        <Rule id="R007" type="numeric" expression="sum(int(d) for d in str(input))" resultTag="DigitSum"/>
        <Rule id="R008" type="boolean" expression="str(input) == str(input)[::-1]" resultTag="IsPalindrome"/>
        <Rule id="R009" type="boolean" expression="input in power2_pattern" resultTag="IsPowerOfTwo"/>
    </Rules>

